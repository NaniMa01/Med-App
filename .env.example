# Pflicht: Gemini API-Schlüssel (serverseitig)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Modell/Endpoint
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional: Limits/Timeout
MAX_SOURCE_TEXT_CHARS=12000
GEMINI_TIMEOUT_MS=25000

# Optional: CORS nur für eine feste Origin (z. B. GitHub Pages)
# ALLOWED_ORIGIN=https://nanima01.github.io
